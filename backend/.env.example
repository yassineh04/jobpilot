# Free AI (optional). One of: none | ollama | groq | gemini
#   ollama: fully local, no key (started by docker compose, see the root .env)
#   groq:   free key from https://console.groq.com  (fast, best quality for free)
#   gemini: free key from https://aistudio.google.com
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
